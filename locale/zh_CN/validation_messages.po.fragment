msgid "must be at least %{bits} bits"
msgstr "必须至少为 %{bits} 位"

msgid "type is forbidden. Must be %{types}"
msgstr "类型被禁止。必须为 %{types}"

msgid "is not a valid SSH key"
msgstr "不是有效的 SSH 密钥"

msgid "is not a valid RSA key"
msgstr "不是有效的 RSA 密钥"

msgid "is not a correct duration"
msgstr "不是有效的时长"

msgid "must be a valid color code"
msgstr "必须是有效的颜色代码"

msgid "must be 40 or 64 hex characters (with optional colons between pairs)"
msgstr "必须是 40 或 64 个十六进制字符（对之间可选用冒号分隔）"

msgid "must be a hash containing only letters, numbers, spaces, : and -"
msgstr "必须是仅包含字母、数字、空格、: 和 - 的哈希"

msgid "is not a valid branch name"
msgstr "不是有效的分支名称"

msgid "is not a valid emoji name"
msgstr "不是有效的表情名称"

msgid "must be a valid line code"
msgstr "必须是有效的行代码"

msgid "must be a valid PEM certificate"
msgstr "必须是有效的 PEM 证书"

msgid "must be a valid PEM private key"
msgstr "必须是有效的 PEM 私钥"

msgid "ECDSA keys with explicit curves are not supported"
msgstr "不支持使用显式曲线的 ECDSA 密钥"

msgid "must contain one valid Zoom URL"
msgstr "必须包含一个有效的 Zoom URL"

msgid "must be an array of strategy hashes"
msgstr "必须是策略哈希数组"

msgid "strategy name is invalid"
msgstr "策略名称无效"

msgid "percentage must be a string between 0 and 100 inclusive"
msgstr "百分比必须是 0 到 100（含）之间的字符串"

msgid "groupId parameter is invalid"
msgstr "groupId 参数无效"

msgid "must associate the same project"
msgstr "必须关联同一个项目"

msgid "must be a top level Group"
msgstr "必须是顶层群组"

msgid "can not be changed because it's synchronized with provider"
msgstr "无法更改，因为它与提供商同步"

msgid "is longer than the allowed length of 4000 characters."
msgstr "长度超过允许的 4000 个字符。"

msgid "is not a valid SHA"
msgstr "不是有效的 SHA"

msgid "syntax is invalid"
msgstr "语法无效"

msgid "has to be present"
msgstr "必须存在"

msgid "is too long"
msgstr "过长"

msgid "Detumbled email has reached the reuse limit"
msgstr "去混淆邮箱已达到重用上限"

msgid "Detumbled email is associated with a banned user"
msgstr "去混淆邮箱关联到已封禁用户"

msgid "Email failed validation check"
msgstr "邮箱未通过验证检查"

msgid "must be ASCII armored"
msgstr "必须是 ASCII armored 格式"

msgid "are all invalid"
msgstr "全部无效"

msgid "is not a recognized work item type"
msgstr "不是可识别的工作项类型"

msgid "owner is not a project member"
msgstr "所有者不是项目成员"

msgid "is not enabled for this project"
msgstr "未为此项目启用"

msgid "should be true when variable is hidden"
msgstr "隐藏变量时此项必须为 true"

msgid "Only new variables can be set as masked and hidden."
msgstr "只有新建变量才能设置为掩码和隐藏。"

msgid "The visibility setting cannot be changed for masked and hidden variables."
msgstr "掩码和隐藏变量的可见性设置无法更改。"

msgid "Taking over an orphaned project runner is not allowed"
msgstr "不允许接管孤立项目 Runner"

msgid "can not be empty when runner is not allowed to pick untagged jobs"
msgstr "当 Runner 不允许运行未打标签的作业时，此项不能为空"

msgid "cannot have allowed plans assigned"
msgstr "不能分配允许的计划"

msgid "cannot have groups assigned"
msgstr "不能分配群组"

msgid "cannot have organization_id assigned"
msgstr "不能分配组织 ID"

msgid "cannot have projects assigned"
msgstr "不能分配项目"

msgid "needs to be assigned to at least one project"
msgstr "需要至少分配给一个项目"

msgid "needs to be assigned to exactly one group"
msgstr "需要恰好分配给一个群组"

msgid "must match the organization of the parent group/project"
msgstr "必须与父群组/项目的组织一致"

msgid "instance_type runners must not have an organization_id"
msgstr "实例类型 Runner 不能带有组织 ID"

msgid "is not a group runner"
msgstr "不是群组 Runner"

msgid "can't be 00000000 (branch removal)"
msgstr "不能为 00000000（分支删除）"

msgid "is immutable"
msgstr "不可修改"

msgid "exceeds the allowable number of group links"
msgstr "超出允许的群组关联数量"

msgid "exceeds the allowable number of project links in this direction"
msgstr "超出此方向上允许的项目关联数量"

msgid "must be an array of strings without `*`"
msgstr "必须是字符串数组且不能包含 `*`"

msgid "must be the same as the release author"
msgstr "必须与发布作者相同"

msgid "has expired"
msgstr "已过期"

msgid "cannot be generated"
msgstr "无法生成"

msgid "can contain only letters, digits, emoji, '_', '.', '+', dashes, or spaces. It must start with a letter, digit, emoji, or '_'."
msgstr "只能包含字母、数字、表情符号、'_'、'.'、'+'、连字符或空格。必须以字母、数字、表情符号或 '_' 开头。"

msgid "can only include non-accented letters, digits, '_', '-' and '.'. It must not start with '-', '_', or '.', nor end with '-', '_', '.', '.git', or '.atom'."
msgstr "只能包含非重音字母、数字、'_'、'-' 和 '.'。不能以 '-'、'_' 或 '.' 开头，也不能以 '-'、'_'、'.'、'.git' 或 '.atom' 结尾。"

msgid "can contain only letters, digits, emoji, '_', '.', dash, space, parenthesis. It must start with letter, digit, emoji or '_'."
msgstr "只能包含字母、数字、表情符号、'_'、'.'、连字符、空格和括号。必须以字母、数字、表情符号或 '_' 开头。"

msgid "can contain only letters, digits, '-', '_', '/', '$', '{', '}', '.', and spaces, but it cannot start or end with '/'"
msgstr "只能包含字母、数字、'-'、'_'、'/'、'$'、'{'、'}'、'.' 和空格，但不能以 '/' 开头或结尾"

msgid "can contain only letters, digits, '-', '_', '/', '$', '{', '}', '.', '*' and spaces"
msgstr "只能包含字母、数字、'-'、'_'、'/'、'$'、'{'、'}'、'.'、'*' 和空格"

msgid "can contain only letters, digits, '_' and '-'. Cannot start with '-'."
msgstr "只能包含字母、数字、'_' 和 '-'。不能以 '-' 开头。"

msgid "can contain only letters, digits, '_' and '-'. Cannot start or end with '-'."
msgstr "只能包含字母、数字、'_' 和 '-'。不能以 '-' 开头或结尾。"

msgid "can contain only letters, digits, '_', '.' and '-'. Cannot start or end with '-' or '.'."
msgstr "只能包含字母、数字、'_'、'.' 和 '-'。不能以 '-' 或 '.' 开头或结尾。"

msgid "can contain only letters, digits, '_', '-' and '.'. Cannot start with '-' or end in '.', '.git' or '.atom'."
msgstr "只能包含字母、数字、'_'、'-' 和 '.'。不能以 '-' 开头，也不能以 '.'、'.git' 或 '.atom' 结尾。"

msgid "can contain only letters, digits, '_', '-' and '.'. Cannot start with '-', end in '.git' or end in '.atom'"
msgstr "只能包含字母、数字、'_'、'-' 和 '.'。不能以 '-' 开头，也不能以 '.git' 或 '.atom' 结尾"

msgid "can contain only letters, digits and '_'."
msgstr "只能包含字母、数字和 '_'。"

msgid "can contain only letters, digits, '_', '-', '+', and '.'"
msgstr "只能包含字母、数字、'_'、'-'、'+' 和 '.'"

msgid "can contain only letters, digits, '_', '-', '.'"
msgstr "只能包含字母、数字、'_'、'-'、'.'"

msgid "can contain only letters, digits, '-', '_' and spaces"
msgstr "只能包含字母、数字、'-'、'_' 和空格"

msgid "Domain denylist cannot be empty if denylist is enabled."
msgstr "启用域名拒绝列表时，拒绝列表不能为空。"

msgid "Incremental logging cannot be turned on without configuring object storage for artifacts."
msgstr "未配置制品对象存储时，无法开启增量日志。"

msgid "URL must be to a Confluence Cloud Workspace hosted on atlassian.net"
msgstr "URL 必须指向托管在 atlassian.net 上的 Confluence Cloud 工作区"

msgid "This alias has already been taken"
msgstr "此别名已被使用"

msgid "Number of permitted priorities exceeded"
msgstr "超出允许的优先级数量"

msgid "Organization is too long (maximum is 500 characters)"
msgstr "组织名称过长（最多 500 个字符）"

msgid "Request timed out. Please try again."
msgstr "请求超时。请重试。"

msgid "The requested resource does not exist."
msgstr "请求的资源不存在。"

msgid "URI is invalid"
msgstr "URI 无效"

msgid "activerecord.errors.messages.invalid"
msgstr "是无效的"

msgid "activerecord.attributes.key.fingerprint_sha256"
msgstr "指纹（SHA256）"

msgid "activerecord.attributes.application_setting.domain_denylist"
msgstr "域名拒绝列表"

# Model and service validation messages added after the 2026-10-17 app-wide scan.
msgid "An error occurred while processing your request"
msgstr "处理您的请求时发生错误"

msgid "Cannot delete an experiment associated to a model"
msgstr "无法删除与模型关联的实验"

msgid "Not authorized"
msgstr "未授权"

msgid "User list is associated with a strategy"
msgstr "用户列表已关联策略"

msgid "You must select source and target branch"
msgstr "必须选择源分支和目标分支"

msgid "You must select different branches"
msgstr "必须选择不同的分支"

msgid "You must transfer ownership of organizations before you can remove user"
msgstr "删除用户前必须先转移组织所有权"

msgid "You must transfer ownership or delete groups before you can remove user"
msgstr "删除用户前必须先转移所有权或删除群组"

msgid "already in use for another service desk address."
msgstr "已被另一个服务台地址使用。"

msgid "can't be different from the previous_path attribute"
msgstr "不能与 previous_path 属性不同"

msgid "cannot add duplicated environment scope"
msgstr "不能重复"

msgid "cannot be blank for extensions setting type"
msgstr "扩展设置类型下不能为空"

msgid "cannot be enabled until verification process has finished."
msgstr "验证流程完成前无法启用。"

msgid "cannot be related to itself"
msgstr "不能与自身关联"

msgid "cannot be true for related link types"
msgstr "关联链接类型不能为 true"

msgid "cannot contain a path traversal component"
msgstr "不能包含路径穿越组件"

msgid "cannot contain escaped HTML entities"
msgstr "不能包含转义的 HTML 实体"

msgid "cannot contain escaped components"
msgstr "不能包含转义组件"

msgid "cannot have higher visibility level than repository access level"
msgstr "可见性级别不能高于仓库访问级别"

msgid "cannot have public visibility level"
msgstr "不能使用公开可见性级别"

msgid "contains a numeric value that is too large"
msgstr "包含过大的数值"

msgid "does not match noteable project"
msgstr "与可评论对象所属项目不匹配"

msgid "does not match the diff refs"
msgstr "与差异引用不匹配"

msgid "doesn't match the certificate"
msgstr "与证书不匹配"

msgid "doesn't support new-style diff notes"
msgstr "不支持新版差异评论"

msgid "each page in a wiki must have a distinct canonical slug"
msgstr "Wiki 中每个页面的规范 slug 必须唯一"

msgid "exceeds allowed JSON complexity limits"
msgstr "超出允许的 JSON 复杂度限制"

msgid "has characters that are not allowed"
msgstr "包含不允许的字符"

msgid "has to be a subgroup of the group"
msgstr "必须是该群组的子群组"

msgid "hosts array cannot be nested"
msgstr "数组不能嵌套"

msgid "is already taken by another project"
msgstr "已被另一个项目占用"

msgid "is empty or does not exist"
msgstr "为空或不存在"

msgid "is forbidden"
msgstr "被禁止"

msgid "is in an invalid format"
msgstr "格式无效"

msgid "is incomplete"
msgstr "不完整"

msgid "is not a valid commit"
msgstr "不是有效的提交"

msgid "is not allowed"
msgstr "不允许"

msgid "is not allowed to import projects"
msgstr "无权导入项目"

msgid "is not included in the list"
msgstr "不在列表中"

msgid "is not valid"
msgstr "无效"

msgid "merge_request cannot be changed"
msgstr "不能更改"

msgid "misses intermediates"
msgstr "缺少中间证书"

msgid "model project must be the same"
msgstr "所属项目必须相同"

msgid "must be blank for non extensions setting type"
msgstr "非扩展设置类型下必须为空"

msgid "must be different from the previous_path attribute"
msgstr "必须与 previous_path 属性不同"

msgid "must be greater than or equal to start date"
msgstr "必须大于或等于开始日期"

msgid "must be present on both design and version"
msgstr "必须在设计和版本中都存在"

msgid "must be the same on design and version"
msgstr "在设计和版本中必须相同"

msgid "must be uploaded"
msgstr "必须上传"

msgid "must contain only scheme and host"
msgstr "只能包含 scheme 和 host"

msgid "must contain scheme and host, and not path"
msgstr "必须包含 scheme 和 host，且不能包含路径"

msgid "must not be a known import source domain"
msgstr "不能是已知的导入源域名"

msgid "must only include ASCII characters"
msgstr "只能包含 ASCII 字符"

msgid "not allowed when performance bar is disabled"
msgstr "性能栏禁用时不允许设置"

msgid "only allowed for project cluster"
msgstr "仅允许用于项目集群"

msgid "organization must match the token scope's organization"
msgstr "必须与令牌范围的组织一致"

msgid "package must be ml_model"
msgstr "必须是 ml_model"

msgid "package name must be the same"
msgstr "名称必须相同"

msgid "package project must be the same"
msgstr "项目必须相同"

msgid "package version must be the same"
msgstr "版本必须相同"

msgid "selective_code_owner_removals can only be enabled when reset_approvals_on_push is disabled"
msgstr "reset_approvals_on_push 禁用时才能启用 selective_code_owner_removals"

msgid "state is already locked"
msgstr "状态已被锁定"

msgid "timezone is not valid"
msgstr "无效"

msgid "cannot start with '%{prefix}.' because the profile URL would be intercepted by an existing route. Please choose a different name."
msgstr "不能以 '%{prefix}.' 开头，因为该个人资料 URL 会被现有路由拦截。请选择其他名称。"

msgid "activerecord.attributes.member.access_level"
msgstr "访问级别"
