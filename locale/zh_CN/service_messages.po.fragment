msgstr "必须遵循语义化版本"

msgid "needs to be at least 10 minutes"
msgstr "至少需要 10 分钟"

msgid "needs to be non-negative"
msgstr "必须为非负数"

msgid "only allows hex characters"
msgstr "只允许十六进制字符"

msgid "should be unique in the project"
msgstr "在项目中必须唯一"

msgid "should have only one list preference per user"
msgstr "每个用户只能有一个列表偏好设置"

msgid "this action forbids content"
msgstr "此操作禁止内容"

msgid "this action needs content"
msgstr "此操作需要内容"

msgid "Another process is already processing a delete request. Please retry later."
msgstr "另一个进程正在处理删除请求。请稍后重试。"

msgid "At least one of move_before_id or move_after_id is required"
msgstr "必须至少提供 move_before_id 或 move_after_id 之一"

msgid "Can't abort the automatic merge"
msgstr "无法中止自动合并"

msgid "Can't cancel the automatic merge"
msgstr "无法取消自动合并"

msgid "Failed to create support PIN"
msgstr "创建支持 PIN 失败"

msgid "Failed to delete snippet repositories."
msgstr "删除代码片段仓库失败。"

msgid "Failed to remove snippets."
msgstr "删除代码片段失败。"

msgid "Failed to revoke support PIN"
msgstr "撤销支持 PIN 失败"

msgid "Invalid JSON response"
msgstr "无效的 JSON 响应"

msgid "No environments found for scheduled deletion. Either your query did not match any environments (default parameters match environments that are 30 days or older), or you have insufficient permissions to delete matching environments."
msgstr "未找到计划删除的环境。您的查询可能未匹配任何环境（默认参数匹配 30 天或更早的环境），或者您没有删除匹配环境的足够权限。"

msgid "Query timed out"
msgstr "查询超时"

msgid "Relation was removed"
msgstr "关联已移除"

msgid "Support PIN not found or already expired"
msgstr "未找到支持 PIN 或该 PIN 已过期"

msgid "Work item not found"
msgstr "未找到工作项"

msgid "You do not have permission to destroy environments in this project"
msgstr "您没有销毁此项目中环境的权限"

msgid "You do not have permission to move items to this namespace."
msgstr "您没有将工作项移动到此命名空间的权限。"

msgid "You don't have access to delete these snippets."
msgstr "您无权删除这些代码片段。"

msgid "You don't have permissions to update this work item"
msgstr "您没有更新此工作项的权限"

msgid "access forbidden"
msgstr "访问被禁止"

msgid "registry not enabled"
msgstr "未启用容器镜像库"

msgid "Cannot move work items from projects to groups."
msgstr "无法将工作项从项目移动到群组。"

msgid "User namespaces are not supported as target namespaces."
msgstr "不支持将用户命名空间作为目标命名空间。"
